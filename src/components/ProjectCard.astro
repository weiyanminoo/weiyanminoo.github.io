---
import { formatProjectPeriod } from '../lib/dates';
import Tags from './Tags.astro';

interface Props {
  name: string;
  kind: string;
  start: Date;
  end: Date | null;
  ongoing: boolean;
  url?: string;
  /** Where its longer write-up lives, when it has one (/projects/<id>). */
  story?: string;
  summary: string;
  outcome: string;
  tags: string[];
  // Home shows the name, kind, period and one-line summary only — the
  // bullets, the outcome, the tags and the link to the live thing are what
  // /projects is for. Same split as SchoolCard's and RoleEntry's.
  detailed?: boolean;
}

const { name, kind, start, end, ongoing, url, story, summary, outcome, tags, detailed = false } = Astro.props;

const period = formatProjectPeriod(start, end, ongoing);
// A project not built yet may have no kind, summary or link: each shows
// only when written.
const meta = [kind, period].filter(Boolean).join(' · ');
// Nothing written beyond its name and dates: the card sizes to that, not
// to the full card beside it in the grid row (a tall empty box otherwise).
const brief = !summary && !url && !outcome && tags.length === 0;
---

<article class:list={['project', 'glass-card', brief && 'is-brief']}>
  <header>
    <h2>{name}</h2>
    <p class="meta">{meta}</p>
  </header>
  {summary && <p class="summary">{summary}</p>}
  {
    detailed && (
      <>
        <div class="body md-body">
          <slot />
        </div>
        {outcome && (
          <p class="outcome">
            <strong>Outcome.</strong> {outcome}
          </p>
        )}
        {tags.length > 0 && (
          <div class="tags-wrap">
            <Tags tags={tags} />
          </div>
        )}
        {(story || url) && (
          <p class="links">
            {story && (
              <a class="link" href={story}>
                Read the story &rarr;
              </a>
            )}
            {url && (
              <a class="link" href={url}>
                Visit {name} &rarr;
              </a>
            )}
          </p>
        )}
      </>
    )
  }
</article>

<style>
  /* Card background — see base.css's .glass-card for the shared
     blur/border/shadow/transition, and intensity.ts's CARD_OPACITY.project
     (66%, matching the mockup's .proj) for the opacity this must match by
     hand. */
  .project {
    padding: 30px;
    background: color-mix(in srgb, var(--card-tint) 58%, transparent);
  }

  .project.is-brief {
    align-self: start;
  }

  h2 {
    font-size: 24px;
  }

  .meta {
    margin: 0 0 20px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .summary {
    max-width: 60ch;
    color: var(--ink-2);
  }

  /* Home's compact card ends here, so its paragraph margin would otherwise
     become dead space inside the card's own padding. */
  .summary:last-child {
    margin-bottom: 0;
  }

  .outcome {
    max-width: 60ch;
    padding: 16px 20px;
    border: 1px solid var(--line);
    color: var(--ink-2);
  }

  .outcome strong {
    color: var(--ink);
  }

  .tags-wrap {
    margin: 20px 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin: 0;
  }

  .link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }
</style>
