---
import { formatRolePeriod } from '../lib/dates';
import Tags from './Tags.astro';

interface Props {
  org: string;
  role: string;
  team?: string;
  discipline: string;
  start: Date;
  end: Date | null;
  current: boolean;
  depth: number;
  tags: string[];
  open?: boolean;
}

const {
  org,
  role,
  team,
  discipline,
  start,
  end,
  current,
  depth,
  tags,
  open = false,
} = Astro.props;

const period = formatRolePeriod(start, end, current);

// Built as an array and joined so every separator gets a space on both
// sides regardless of which optional fields are present — avoids relying
// on JSX whitespace, which collapses newline-plus-indent between siblings.
const meta = [discipline, team, `${depth}m`].filter(Boolean).join(' · ');
---

<details class="role" open={open}>
  <summary>
    <span class="period">{period}</span>
    <span class="heading">
      <span class="org">{org}</span>
      {current && <span class="current-mark">Current</span>}
    </span>
    <span class="role-title">{role}</span>
    <span class="meta">{meta}</span>
  </summary>
  <div class="role-body md-body">
    <slot />
    <Tags tags={tags} />
  </div>
</details>

<style>
  .role {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    min-height: 44px;
    padding-block: 20px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .period {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-3);
    min-width: 13ch;
  }

  .heading {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }

  .org {
    font-weight: 700;
    font-size: 17px;
  }

  .current-mark {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--mark);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .role-title {
    color: var(--ink-2);
    font-size: 15px;
  }

  .meta {
    width: 100%;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .role-body {
    padding-bottom: 24px;
  }
</style>
