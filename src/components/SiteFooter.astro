    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 88px;
  }

  .container {
    padding-block: 0 40px;
  }

  /* Card background — see base.css's .glass-card for the shared
     blur/border/shadow/transition. The mockup's own footer/.contact has no
     card at all (it sits directly on the deep water), but our footer's own
     `.copy`/`.sub` render in the secondary --ink-2/--ink-3 tokens rather
     than the mockup's single light-text colour, and those tokens are not
     safe uncarded within a real page's particle-effect range (see
     tests/water/effects.test.ts's "not on a card" bound) — so, unlike the
     mockup, this stays carded. Reuses CARD_OPACITY.project (66%, must
     match intensity.ts by hand) rather than a fifth opacity constant. */
  .card {
    padding: 32px;
    background: color-mix(in srgb, var(--card-tint) 66%, transparent);
  }

  h2 {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .copy {
    margin: 0 0 28px;
    max-width: 46ch;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin: 0 0 40px;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-3);
  }

  .contacts a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .rule {
    height: 1px;
    background: var(--line);
    margin: 0 0 20px;
  }

  .sub {
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-3);
  }
</style>
