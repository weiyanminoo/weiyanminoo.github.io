<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 120px;
  }

  .container {
    padding-block: 56px 40px;
  }

  h2 {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .copy {
    margin: 0 0 28px;
    max-width: 46ch;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin: 0 0 40px;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-3);
  }

  .contacts a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .rule {
    height: 1px;
    background: var(--line);
    margin: 0 0 20px;
  }

  .sub {
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-3);
  }
</style>
