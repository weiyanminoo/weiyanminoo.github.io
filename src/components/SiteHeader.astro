---
// `overlay` floats the menu over the landing's film: fixed, transparent,
// light text. `solid` is the frosted header every other page uses.
interface Props {
  variant?: 'overlay' | 'solid';
}

const { variant = 'solid' } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/school', label: 'School' },
  { href: '/projects', label: 'Projects' },
  { href: '/hobbies', label: 'Hobbies' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href;
---

<header class:list={['site-header', variant === 'overlay' && 'is-overlay']}>
  <div class="container row">
    <p class="wordmark">WEI YAN</p>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* The solid variant: frosted glass over the static pages' still water,
     matching the mockup's header.top (rgba(246,249,249,.5) + blur 14px).
     margin-left follows --rail, the gutter the old depth rail reserved;
     both layouts now set it to 0. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    margin-left: var(--rail);
    background: color-mix(in srgb, var(--card-tint) 50%, transparent);
    /* Unprefixed only — see base.css's .glass-card for why the hand-written
       -webkit- companion had to go (the minifier collapsed the pair to the
       prefixed form alone, which current Chromium drops). */
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--line);
    transition:
      background 0.9s var(--ease),
      border-color 0.9s var(--ease);
  }

  /* base.css's .container folds the mockup's .shell offset and .wrap's own
     centring into one element, because main/footer have no .shell to sit
     in. This header now DOES carry that offset itself (above), so its
     container must contribute only the .wrap half of the maths or the rail
     width is counted twice. `100%` here is the header's content box —
     viewport minus the rail — exactly what the mockup's .wrap is centred
     in. Measured: content box left edge 168px at 1440, identical to
     `main .container`. */
  .site-header .container {
    margin-left: max(0px, (100% - 1180px) / 2);
    margin-right: max(0px, (100% - 1180px) / 2);
  }

  /* Over the landing's film there is no bar at all (spec §6 bans white
     header bars): just the links, light, with a soft shadow so they hold
     contrast over the bright surface water. */
  .site-header.is-overlay {
    position: fixed;
    inset: 0 0 auto 0;
    margin-left: 0;
    background: none;
    backdrop-filter: none;
    border-bottom: 0;
    color: var(--on-deep);
    text-shadow: 0 1px 12px rgba(4, 16, 28, 0.55);
  }

  /* A soft darkening at the top of the frame, like a film's title-safe
     gradient — no bar and no edge. Without it the links fall to ~1.3:1 over
     the bright Snell's window at the surface; with it they hold AA there. */
  .site-header.is-overlay::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 150px;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(4, 16, 28, 0.62), rgba(4, 16, 28, 0.38) 45%, transparent);
  }

  .site-header.is-overlay .container {
    margin-left: max(16px, (100% - 1180px) / 2);
    margin-right: max(16px, (100% - 1180px) / 2);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }

  .wordmark {
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.2em;
  }

  nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    font-size: 14px;
  }

  nav a[aria-current='page'] {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (max-width: 860px) {
    .wordmark {
      display: none;
    }

    nav ul {
      width: 100%;
      justify-content: space-between;
      gap: 16px;
    }

    nav a {
      font-size: 13px;
    }
  }
</style>

