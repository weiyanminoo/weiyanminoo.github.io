---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/archivo';
import '@fontsource-variable/spline-sans-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WaterCanvas from '../components/WaterCanvas.astro';
import DepthRail from '../components/DepthRail.astro';

// Two page kinds, matching depth.ts's two bands: `column` is Home, the one
// page that descends 0-32m and carries the rail; `shallow` is every tab —
// still water at depth.ts's STILL (6m), no rail, no descent.
interface Props {
  title: string;
  description: string;
  depth?: 'shallow' | 'column';
}

const { title, description, depth = 'shallow' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og.png', Astro.site);

const siteName = 'Wei Yan';

// Same depth -> background mapping as the fallback <html> styles below,
// so the browser chrome (theme-color) matches what the page paints before
// any script runs. Literal hex, not the CSS custom properties: this is a
// meta tag's content attribute, not a stylesheet.
const themeColors: Record<NonNullable<Props['depth']>, string> = {
  shallow: '#E9F1F2',
  column: '#F6F9F9',
};
---

<!doctype html>
<html lang="en" class={`depth-${depth}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <meta name="theme-color" content={themeColors[depth]} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — Computer Science, NUS`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <WaterCanvas />
    <div class="grain" aria-hidden="true"></div>
    {/* Only the descending page has a depth to read out. On a still page
        the rail would show one unchanging number forever, and its 76px
        gutter is reclaimed by the content (see html:not(.depth-column)
        below). */}
    {depth === 'column' && <DepthRail />}
    <SiteHeader />
    <main id="main" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>
    {
      depth === 'column' ? (
        <div class="zone-deep">
          <SiteFooter />
        </div>
      ) : (
        <SiteFooter />
      )
    }
  </body>
</html>

<style>
  /* Fallback background per depth, painted on <html> so it is correct
     before any script runs (and with no script at all). The canvas
     (fixed, z-index: -1) paints over this once it mounts. Body stays
     transparent so this shows through. */
  /* Every tab. Still water at depth.ts's STILL (6m), whose palette stop is
     rgb(234,242,243) — within one channel step of --shallow, so this
     fallback and the canvas paint the same colour. Dark ink throughout:
     6m is far above the 20m depth where the ink tokens stop clearing
     4.5:1, so no page-level zone switching is needed here at all. */
  html.depth-shallow {
    --bg: var(--shallow);
    background: var(--bg);
    color: var(--ink);
  }

  /* The rail renders on the descending page only, so on every other page
     the gutter it reserves belongs to the content. Without this the tabs
     keep a 76px left inset with nothing in it, and their text column sits
     off-centre. Outranks tokens.css's `:root{--rail:76px}` and its 860px
     override on specificity (0,1,1 beats 0,1,0), not source order. */
  html:not(.depth-column) {
    --rail: 0px;
  }

  /* Home: no single fixed text colour, since it spans the whole column and
     crosses the thermocline. Background falls back to the surface colour —
     what the top of the page shows before the canvas (or with no JS at
     all) — and Home's own sections declare a light or deep zone (below). */
  html.depth-column {
    --bg: var(--foam);
    background: var(--bg);
    color: var(--ink);
  }

  /* Reusable per-section zone classes for the `column` page. :global so
     they also apply to the slotted sections in index.astro, which are
     scoped to that file, not this one. */
  :global(.zone-light) {
    color: var(--ink);
  }

  :global(.zone-deep) {
    color: var(--on-deep);
    --ink-2: var(--on-deep-2);
    --ink-3: var(--on-deep-3);
    --line: var(--line-deep);
    --focus: var(--mark);
    /* Dark glass for Home's own deep-zone section and footer. Since the
       tabs became still water this is the only place on the site that
       carries deep-zone colours, so these are not a duplicate of a
       page-level rule — they are the rule. */
    --card-tint: var(--deep);
    --card-border: rgba(255, 255, 255, 0.18);
    --card-shadow: rgba(3, 14, 20, 0.28);
    --card-shadow-hover: rgba(3, 14, 20, 0.34);
  }

  /* Mockup's `.grain`, verbatim: one fixed radial wash of white at the top
     of every viewport, above the canvas (z-index -2) and below all content.
     Part of why the mockup's surface water reads brighter than ours at the
     same nominal caustics strength — see phase-7-9-report.md. Static, so it
     needs no reduced-motion handling, and purely decorative, so aria-hidden.
     Its vertical radius is 70% of the viewport and it is fully transparent
     by 60% of that, i.e. it has no effect below ~42% of viewport height;
     that is why it does not reach the deep-zone body text that sits lower
     in the frame, and the contrast sweep was re-run to confirm rather than
     assume it. */
  .grain {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.5;
    background: radial-gradient(
      ellipse 120% 70% at 50% 0%,
      rgba(255, 255, 255, 0.28),
      transparent 60%
    );
  }

  main {
    display: block;
  }

  /* tabindex="-1" makes this focusable only programmatically, enabling the
     skip link (#main) to move keyboard focus to the main content area (WCAG
     2.4.1: Bypass Blocks). Outline is suppressed because <main> is a skip
     target and container, not an interactive control — focus will never
     reach it via Tab, and a full-page outline would appear as a bug. */
  main:focus-visible {
    outline: none;
  }

  /* No block padding of its own: as of Phase 8 the vertical rhythm lives
     entirely on `section` (base.css, the mockup's `section{padding:112px 0}`)
     and on the hero/thermocline overrides that replace it, so the container
     adding its own 64/96 on top would double-count the space between the
     header and the first section. */
  main .container {
    padding-block: 0;
  }
</style>
