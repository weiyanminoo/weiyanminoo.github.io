---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/archivo';
import '@fontsource-variable/spline-sans-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WaterCanvas from '../components/WaterCanvas.astro';
import DepthRail from '../components/DepthRail.astro';

interface Props {
  title: string;
  description: string;
  depth?: 'foam' | 'shallow' | 'mid' | 'deep' | 'column';
}

const { title, description, depth = 'foam' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class={`depth-${depth}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <WaterCanvas />
    <DepthRail />
    <SiteHeader />
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    {
      depth === 'column' ? (
        <div class="zone-deep">
          <SiteFooter />
        </div>
      ) : (
        <SiteFooter />
      )
    }
  </body>
</html>

<style>
  /* Fallback background per depth, painted on <html> so it is correct
     before any script runs (and with no script at all). The canvas
     (fixed, z-index: -1) paints over this once it mounts. Body stays
     transparent so this shows through. */
  html.depth-foam {
    --bg: var(--foam);
    background: var(--bg);
    color: var(--ink);
  }

  html.depth-shallow {
    --bg: var(--shallow);
    background: var(--bg);
    color: var(--ink);
  }

  html.depth-mid {
    --bg: var(--mid);
    background: var(--bg);
    color: var(--ink);
  }

  html.depth-deep {
    --bg: var(--deep);
    background: var(--bg);
    color: var(--on-deep);
    --ink-2: var(--on-deep-2);
    --ink-3: var(--on-deep-3);
    --line: var(--line-deep);
    /* --ink (the --focus default) is unreadable on deep; --mark passes
       there instead (~5.75:1), where it fails on the lighter depths */
    --focus: var(--mark);
    /* DepthRail.astro's scrim reads this; defaults to foam otherwise. Set
       here (not just via the rail's own JS-driven .is-deep toggle) so the
       deep page still gets the right scrim tint with JavaScript disabled. */
    --rail-scrim-tint: var(--deep);
  }

  /* Home: no single fixed text colour, since it spans the whole column and
     crosses the thermocline. Background falls back to the surface colour —
     what the top of the page shows before the canvas (or with no JS at
     all) — and Home's own sections declare a light or deep zone (below). */
  html.depth-column {
    --bg: var(--foam);
    background: var(--bg);
    color: var(--ink);
  }

  /* Reusable per-section zone classes for the `column` page. :global so
     they also apply to the slotted sections in index.astro, which are
     scoped to that file, not this one. */
  :global(.zone-light) {
    color: var(--ink);
  }

  :global(.zone-deep) {
    color: var(--on-deep);
    --ink-2: var(--on-deep-2);
    --ink-3: var(--on-deep-3);
    --line: var(--line-deep);
    --focus: var(--mark);
  }

  main {
    display: block;
  }

  main .container {
    padding-block: 64px 96px;
  }
</style>
