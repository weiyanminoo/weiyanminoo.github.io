---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/archivo';
import '@fontsource-variable/spline-sans-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WaterCanvas from '../components/WaterCanvas.astro';
import DepthRail from '../components/DepthRail.astro';

interface Props {
  title: string;
  description: string;
  depth?: 'foam' | 'shallow' | 'mid' | 'deep' | 'column';
}

const { title, description, depth = 'foam' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og.png', Astro.site);

const siteName = 'Wei Yan';

// Same depth -> background mapping as the fallback <html> styles below,
// so the browser chrome (theme-color) matches what the page paints before
// any script runs. Literal hex, not the CSS custom properties: this is a
// meta tag's content attribute, not a stylesheet.
const themeColors: Record<NonNullable<Props['depth']>, string> = {
  foam: '#F6F9F9',
  shallow: '#E9F1F2',
  mid: '#CFE1E4',
  deep: '#1B4A5C',
  column: '#F6F9F9',
};
---

<!doctype html>
<html lang="en" class={`depth-${depth}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <meta name="theme-color" content={themeColors[depth]} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — Computer Science, NUS`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <WaterCanvas />
    <DepthRail />
    <SiteHeader />
    <main id="main" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>
    {
      depth === 'column' ? (
        <div class="zone-deep">
          <SiteFooter />
        </div>
      ) : (
        <SiteFooter />
      )
    }
  </body>
</html>

<style>
  /* Fallback background per depth, painted on <html> so it is correct
     before any script runs (and with no script at all). The canvas
     (fixed, z-index: -1) paints over this once it mounts. Body stays
     transparent so this shows through. */
  html.depth-foam {
    --bg: var(--foam);
    background: var(--bg);
    color: var(--ink);
  }

  html.depth-shallow {
    --bg: var(--shallow);
    background: var(--bg);
    color: var(--ink);
  }

  html.depth-mid {
    --bg: var(--mid);
    background: var(--bg);
    color: var(--ink);
  }

  html.depth-deep {
    --bg: var(--deep);
    background: var(--bg);
    color: var(--on-deep);
    --ink-2: var(--on-deep-2);
    --ink-3: var(--on-deep-3);
    --line: var(--line-deep);
    /* --ink (the --focus default) is unreadable on deep; --mark passes
       there instead (~5.75:1), where it fails on the lighter depths */
    --focus: var(--mark);
    /* DepthRail.astro's scrim reads this; defaults to foam otherwise. Set
       here (not just via the rail's own JS-driven .is-deep toggle) so the
       deep page still gets the right scrim tint with JavaScript disabled. */
    --rail-scrim-tint: var(--deep);
    /* Phase 7: the same mechanism, for the frosted-glass cards (RoleEntry,
       ProjectCard, LogSlate's section wrapper, SiteHeader, tokens.css's
       --card-tint default is foam) — dark glass, correct with no
       JavaScript, same reasoning as --rail-scrim-tint above. */
    --card-tint: var(--deep);
    --card-border: rgba(255, 255, 255, 0.18);
    --card-shadow: rgba(3, 14, 20, 0.28);
    --card-shadow-hover: rgba(3, 14, 20, 0.34);
  }

  /* Home: no single fixed text colour, since it spans the whole column and
     crosses the thermocline. Background falls back to the surface colour —
     what the top of the page shows before the canvas (or with no JS at
     all) — and Home's own sections declare a light or deep zone (below). */
  html.depth-column {
    --bg: var(--foam);
    background: var(--bg);
    color: var(--ink);
  }

  /* Reusable per-section zone classes for the `column` page. :global so
     they also apply to the slotted sections in index.astro, which are
     scoped to that file, not this one. */
  :global(.zone-light) {
    color: var(--ink);
  }

  :global(.zone-deep) {
    color: var(--on-deep);
    --ink-2: var(--on-deep-2);
    --ink-3: var(--on-deep-3);
    --line: var(--line-deep);
    --focus: var(--mark);
    /* Phase 7: same mechanism as html.depth-deep above, for Home's own
       deep-zone section (it has no depth-deep class of its own to hang
       this off — see that block's comment). */
    --card-tint: var(--deep);
    --card-border: rgba(255, 255, 255, 0.18);
    --card-shadow: rgba(3, 14, 20, 0.28);
    --card-shadow-hover: rgba(3, 14, 20, 0.34);
  }

  main {
    display: block;
  }

  /* tabindex="-1" makes this focusable only programmatically, enabling the
     skip link (#main) to move keyboard focus to the main content area (WCAG
     2.4.1: Bypass Blocks). Outline is suppressed because <main> is a skip
     target and container, not an interactive control — focus will never
     reach it via Tab, and a full-page outline would appear as a bug. */
  main:focus-visible {
    outline: none;
  }

  main .container {
    padding-block: 64px 96px;
  }
</style>
