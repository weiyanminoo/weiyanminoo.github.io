---
// The section pages (Work, School, Projects, Hobbies): static and easy to
// read, for the visitor who came for the details rather than the film. No
// canvas, no scroll effects, no ClientRouter. The whole page is under
// water — the blue, lit a little from above, a few bubbles rising, nothing
// else: no reef, no fish — so it is the same water as the landing at no
// runtime cost. (A band of reef at the top fought the page's title, and a
// light page under it broke the spell, round 9.) No footer: the page ends
// where its content does.
import '@fontsource-variable/archivo';
import '@fontsource-variable/spline-sans-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// The bubbles: eighteen, each with its own place, size, pace and sway,
// seeded so every build draws the same water.
const hash = (i: number, k: number) => {
  const x = Math.sin(i * 127.1 + k * 311.7) * 43758.5453;
  return x - Math.floor(x);
};
const BUBBLES = Array.from({ length: 18 }, (_, i) => ({
  x: `${(3 + 94 * hash(i, 1)).toFixed(1)}%`,
  y: `${(6 + 86 * hash(i, 5)).toFixed(1)}%`,
  size: `${(4 + 12 * hash(i, 2) ** 2).toFixed(1)}px`,
  duration: `${(10 + 10 * hash(i, 3)).toFixed(1)}s`,
  delay: `${(-20 * hash(i, 4)).toFixed(1)}s`,
  sway: `${((hash(i, 6) - 0.5) * 60).toFixed(0)}px`,
}));

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og.jpg', Astro.site);
const siteName = 'Wei Yan';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <meta name="theme-color" content="#1B4A5C" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — Computer Science, NUS`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="water" aria-hidden="true">
      {
        BUBBLES.map((b) => (
          <i style={`--x:${b.x};--y:${b.y};--size:${b.size};--duration:${b.duration};--delay:${b.delay};--sway:${b.sway}`} />
        ))
      }
    </div>
    <SiteHeader variant="overlay" />
    <main id="main" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>
  </body>
</html>

<style>
  /* Deep water throughout: light ink and hairlines, as the landing has
     over its film, and cards as dark glass so the bubbles show through.
     Global and doubled up (html:root) to outrank tokens.css's :root —
     Astro's scoped selectors are :where()-wrapped and would lose to it. */
  :global(html:root) {
    --rail: 0px;
    --bg: var(--deep);
    --ink: var(--on-deep);
    --ink-2: var(--on-deep-2);
    --ink-3: var(--on-deep-3);
    --line: var(--line-deep);
    --focus: var(--mark);
    /* Each card mixes this at its own opacity (as low as 58%), so the
       tint itself is solid: the running text on a card must hold AA over
       the lit top of the water as well as the dark below. */
    --card-tint: rgb(9, 36, 50);
    --card-border: rgba(255, 255, 255, 0.14);
    --card-shadow: rgba(2, 10, 18, 0.3);
    --card-shadow-hover: rgba(2, 10, 18, 0.42);
    background: var(--bg);
    color: var(--ink);
  }

  /* The water, fixed to the viewport so the page scrolls through it: lit
     from above (but no lighter than the small ink needs for AA), cobalt
     through the middle, the dark below; two soft shafts coming down. */
  .water {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background:
      linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.05) 37%, transparent 44%),
      linear-gradient(98deg, transparent 58%, rgba(255, 255, 255, 0.035) 67%, transparent 76%),
      linear-gradient(to bottom, #185068 0%, var(--deep) 40%, var(--abyss) 100%);
  }

  /* A bubble: a thin bright rim, a highlight up and to the left, the
     water showing through the middle. */
  .water i {
    position: absolute;
    left: var(--x);
    bottom: -24px;
    width: var(--size);
    aspect-ratio: 1;
    border-radius: 50%;
    /* Dim enough that one passing behind a card's translucent tint cannot
       lift the ground under its text past AA (the audit caught a tag pill
       at 4.37:1 with a bubble's highlight behind it). */
    background: radial-gradient(
      circle at 36% 32%,
      rgba(255, 255, 255, 0.55) 0,
      rgba(255, 255, 255, 0.22) 18%,
      rgba(255, 255, 255, 0.03) 45%,
      rgba(255, 255, 255, 0.02) 70%,
      rgba(255, 255, 255, 0.28) 100%
    );
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
    animation: rise var(--duration) linear var(--delay) infinite;
  }

  @keyframes rise {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    6% {
      opacity: 0.85;
    }
    50% {
      transform: translate(var(--sway), calc(-50vh - 60px));
    }
    94% {
      opacity: 0.6;
    }
    100% {
      transform: translate(0, calc(-100vh - 140px));
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .water i {
      animation: none;
      bottom: auto;
      top: var(--y);
      opacity: 0.55;
    }
  }

  /* The header floats over the water; the page starts below it. */
  main {
    display: block;
    padding-top: clamp(104px, 15vh, 160px);
    padding-bottom: clamp(64px, 12vh, 140px);
  }

  main:focus-visible {
    outline: none;
  }

  main .container {
    padding-block: 0;
  }

  /* Dark glass needs no blur to read; the bubbles pass behind it. */
  main :global(.glass-card) {
    backdrop-filter: none;
  }

  /* Readable measure for running text. */
  main :global(p),
  main :global(li) {
    max-width: 68ch;
  }
</style>
