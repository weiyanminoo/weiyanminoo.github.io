---
import DiveLayout from '../layouts/DiveLayout.astro';
import { formatProjectPeriod, formatRolePeriod } from '../lib/dates';
import { HOBBIES } from '../lib/hobbies';
import { SCHOOL_SLOTS, PROJECT_SLOTS } from '../lib/slots';
import { SECTION_PROGRESS, diveStateAt } from '../scripts/dive/timeline';
import type { SectionId } from '../scripts/dive/types';
import { getCollection } from 'astro:content';

const title = 'Wei Yan — Computer Science, NUS';
const description =
  'Wei Yan, Computer Science at the National University of Singapore. Software engineering, mobile, product and automation.';

// No render() anywhere on this page. The landing shows each record's
// summary row and nothing more — the markdown bodies are what /work,
// /school and /projects are for.
const roles = await getCollection('roles');
const allRoles = [...roles].sort((a, b) => b.data.start.getTime() - a.data.start.getTime());

const school = await getCollection('school');
const allSchool = [...school].sort((a, b) => a.data.order - b.data.order);

const projects = await getCollection('projects');
const allProjects = [...projects].sort((a, b) => b.data.start.getTime() - a.data.start.getTime());

const schoolBlanks = Math.max(0, SCHOOL_SLOTS - allSchool.length);
const projectBlanks = Math.max(0, PROJECT_SLOTS - allProjects.length);

// Each section's depth label is the film's own depth at that section, read
// from the same timeline the scene renders — so the label, the depth gauge
// and the water behind the text always agree.
const depthLabel = (id: SectionId) => `${Math.round(diveStateAt(SECTION_PROGRESS[id]).depth)} M`;

// Scroll room between stations, in viewport heights, so the film has time
// between summaries (spec §6). Only applied when the film runs.
const GAP_VH = {
  afterTitle: 80,
  afterAbout: 140,
  afterWork: 100,
  afterSchool: 100,
  afterProjects: 140,
  afterHobbies: 100,
  tail: 60,
};

const still = (id: SectionId) => `/dive/stills/${id}.jpg`;
---

<DiveLayout title={title} description={description}>
  <section class="station title" data-section="title" id="title">
    <img class="still" src={still('title')} alt="" loading="lazy" decoding="async" />
    <div class="content container">
      <h1 class="title-h1" tabindex="-1">Wei Yan</h1>
      <p class="meta">
        SINGAPORE &middot; NATIONAL UNIVERSITY OF SINGAPORE &middot; COMPUTER SCIENCE
      </p>
      <a class="dive-in" href="#about">Dive in</a>
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.afterTitle}`} aria-hidden="true"></div>

  <section class="station about" data-section="about" id="about" tabindex="-1">
    <img class="still" src={still('about')} alt="" loading="lazy" decoding="async" />
    <div class="content container">
      <p class="statement">
        Driven by curiosity and a growth mindset, I love tackling complex problems and working on
        innovative solutions.
      </p>
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.afterAbout}`} aria-hidden="true"></div>

  <section class="station" data-section="work" id="work" aria-labelledby="work-title">
    <img class="still" src={still('work')} alt="" loading="lazy" decoding="async" />
    <div class="content container">
      <header class="chapter">
        <h2 class="chapter-title" id="work-title">Work</h2>
        <p class="chapter-depth">{depthLabel('work')}</p>
      </header>
      <ol class="log">
        {
          allRoles.map((entry) => (
            <li class="log-row">
              <p class="log-depth">
                <span class="log-mark" aria-hidden="true" />
                <span class="visually-hidden">Logged at </span>
                {entry.data.depth} m
              </p>
              <div class="log-main">
                <h3 class="log-org">
                  {entry.data.org}
                  {entry.data.current && <span class="log-now">Now</span>}
                </h3>
                <p class="log-role">{entry.data.role}</p>
              </div>
              <p class="log-meta">
                <span>{formatRolePeriod(entry.data.start, entry.data.end, entry.data.current)}</span>
                <span>{entry.data.discipline}</span>
              </p>
            </li>
          ))
        }
      </ol>
      <p class="more"><a href="/work">All {allRoles.length} roles in detail</a></p>
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.afterWork}`} aria-hidden="true"></div>

  <section class="station" data-section="school" id="school" aria-labelledby="school-title">
    <img class="still" src={still('school')} alt="" loading="lazy" decoding="async" />
    <div class="content container">
      <header class="chapter">
        <h2 class="chapter-title" id="school-title">School</h2>
        <p class="chapter-depth">{depthLabel('school')}</p>
      </header>
      <div class="pair">
        {
          allSchool.map((entry) => (
            <article class="entry">
              <h3 class="entry-name">{entry.data.institution}</h3>
              <p class="entry-line">{entry.data.qualification}</p>
              <p class="entry-meta">{entry.data.period}</p>
            </article>
          ))
        }
        {
          Array.from({ length: schoolBlanks }, () => (
            <p class="entry entry--blank">A second school, not yet added</p>
          ))
        }
      </div>
      <p class="more"><a href="/school">Where I have studied</a></p>
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.afterSchool}`} aria-hidden="true"></div>

  <section class="station" data-section="projects" id="projects" aria-labelledby="projects-title">
    <img class="still" src={still('projects')} alt="" loading="lazy" decoding="async" />
    <div class="content container">
      <header class="chapter">
        <h2 class="chapter-title" id="projects-title">Projects</h2>
        <p class="chapter-depth">{depthLabel('projects')}</p>
      </header>
      <p class="chapter-dek">Built on my own time.</p>
      <div class="pair">
        {
          allProjects.map((entry) => (
            <article class="entry">
              <h3 class="entry-name">{entry.data.name}</h3>
              <p class="entry-meta">
                {entry.data.kind} &middot; {formatProjectPeriod(entry.data.start, entry.data.ongoing)}
              </p>
              <p class="entry-line">{entry.data.summary}</p>
            </article>
          ))
        }
        {
          Array.from({ length: projectBlanks }, () => (
            <p class="entry entry--blank">A project not yet added</p>
          ))
        }
      </div>
      <p class="more"><a href="/projects">Every project in detail</a></p>
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.afterProjects}`} aria-hidden="true"></div>

  <section class="station" data-section="hobbies" id="hobbies" aria-labelledby="hobbies-title">
    <img class="still" src={still('hobbies')} alt="" loading="lazy" decoding="async" />
    <div class="content container">
      <header class="chapter">
        <h2 class="chapter-title" id="hobbies-title">Hobbies</h2>
        <p class="chapter-depth">{depthLabel('hobbies')}</p>
      </header>
      <p class="chapter-dek">Outside the work.</p>
      <ul class="pursuits">
        {
          HOBBIES.map((hobby) => (
            <li class="pursuit">
              <h3 class="pursuit-name">{hobby.title}</h3>
              {hobby.line && <p class="pursuit-line">{hobby.line}</p>}
            </li>
          ))
        }
      </ul>
      <p class="more"><a href="/hobbies">More outside the work</a></p>
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.afterHobbies}`} aria-hidden="true"></div>

  <!-- The last station is the deep itself: the film's final stretch, with
       nothing written over it. -->
  <section class="station contact" data-section="contact" id="contact">
    <img class="still" src={still('contact')} alt="" loading="lazy" decoding="async" />
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.tail}`} aria-hidden="true"></div>

  <!-- The seabed: the page's last line, at 40 m. The three ways to reach
       Wei Yan on the left, the way back up on the right. -->
  <div class="seabed">
    <div class="container row">
      <ul class="links">
        <li><a href="mailto:weiyanminoo1@gmail.com">weiyanminoo1@gmail.com</a></li>
        <li><a href="https://github.com/weiyanminoo" rel="noopener">github.com/weiyanminoo</a></li>
        <li>
          <a href="https://www.linkedin.com/in/wei-yan-min-oo/" rel="noopener">linkedin.com/in/wei-yan-min-oo</a>
        </li>
      </ul>
      <a class="surface" href="#title">Surface</a>
    </div>
  </div>
</DiveLayout>

<script>
  import { createAudio, frameSync, renderPreview } from '../scripts/dive/audio';
  import { readMuted } from '../scripts/dive/audioMath';
  import { mountDive, type DiveHandle } from '../scripts/dive/index';
  import { wireUi } from '../scripts/dive/ui';

  const root = document.querySelector('main');
  if (root) {
    // The controls and sound work with or without the film (reduced
    // motion, no WebGL).
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const storage = (() => {
      try {
        return window.localStorage;
      } catch {
        return null;
      }
    })();
    let dive: DiveHandle | null = null;
    const audio = createAudio({
      clock: () => dive?.timeS ?? performance.now() / 1000,
      muted: readMuted(storage),
    });
    // Wired before the film mounts, which can take a while (scene build,
    // shader warm-up): until it is up, the controls work without it.
    wireUi({
      getLenis: () => dive?.lenis ?? null,
      onDiveIn: () => dive?.startEntry(),
      reducedMotion,
      audio,
      storage,
    });
    dive = await mountDive(root, { onFrame: frameSync(audio) });
    if (new URLSearchParams(location.search).has('review')) {
      Object.assign(window, {
        __diveAudio: audio,
        __diveAudioPreview: (seconds: number, depthM: number) => renderPreview(seconds, depthM),
      });
    }
  }
</script>

<style>
  /* (The landing's light-ink token overrides live in DiveLayout, which owns
     <main>: a scoped `main` rule here would never match it.) */

  /* Without the film the spacers collapse, so no-JS and reduced-motion
     readers get a compact page. html.dive-js is set before first paint by
     DiveLayout's inline script. */
  .gap {
    height: 6vh;
  }

  :global(html.dive-js) .gap {
    height: calc(var(--gap) * 1vh);
  }

  .station {
    position: relative;
    isolation: isolate;
  }

  /* The scrim: a soft darkening behind each station's text instead of a
     card — no edges, nothing to read as glass. CSS rather than shader so it
     also works without the film (plan deviation, ledgered). */
  /* Two layers: a radial centred behind the text column (left-aligned in
     the container, so not the page centre), and a feathered band across
     the station's full width, so labels at the far edge still hold AA over
     the brightest water. The film stays clear in the gaps between. */
  .station::before {
    content: '';
    position: absolute;
    /* Feathered above and below; never wider than the page, which would
       scroll it sideways. */
    inset: -12% 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 65% at var(--scrim-x, 38%) 50%, rgba(5, 20, 35, var(--scrim, 0.6)), transparent 72%),
      linear-gradient(
        to bottom,
        transparent,
        rgba(5, 20, 35, var(--band, 0.48)) 16%,
        rgba(5, 20, 35, var(--band, 0.48)) 84%,
        transparent
      );
  }

  /* The title sits over the brightest water in the film (just under the
     surface), so its scrim is the deepest. Work is read over the reef top
     under the camera's light, and Projects while the camera looks up into
     the blue for the manta and turns back past the lit face, so those are
     next. */
  .title {
    --scrim: 0.75;
  }

  .station[data-section='work'],
  .station[data-section='projects'] {
    --scrim: 0.74;
    --band: 0.62;
  }

  /* Poster frames behind each station when the film is not running. Hidden
     from first paint whenever the film is expected (html.dive-js), so a
     lazy image hidden by display:none is never fetched on the film path;
     index.ts adds .dive-off if the film stops (e.g. a lost GPU context). */
  .still {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(html.dive-js:not(.dive-off)) .still {
    display: none;
  }

  /* The focus pull (spec §6): a station's text settles in as it reaches the
     viewport's centre, and eases away as it leaves. --pull is set per
     station by index.ts from where its text block is, so a long section is
     fully there all the way through reading it; it defaults to 1, so
     without the film nothing ever fades. A fade and a short drift, not a
     blur: a blur filter on large text re-rasterised every frame and cost
     the scroll its smoothness. Not named --focus — that token is the
     focus-ring colour. */
  .content {
    opacity: calc(0.15 + 0.85 * var(--pull, 1));
    transform: translateY(calc((1 - var(--pull, 1)) * 16px));
    will-change: opacity, transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .content {
      opacity: 1;
      transform: none;
    }
  }

  /* The title and About take focus only programmatically (Surface and Dive
     in land on them); they are not controls, so no ring — the same as
     main, the skip link's target. */
  [tabindex='-1']:focus-visible {
    outline: none;
  }

  .title {
    min-height: 92vh;
    display: flex;
    align-items: center;
  }

  /* The station is a flex row (for the vertical centring), so this
     shrink-wraps to the name's own width: the block stays in the left
     column where it was, Dive in at its left edge, and only the line under
     the name spans the name and centres to it (round 11). */
  .title .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* The line takes no part in the column's width (width 0), then spans
     exactly the name (min-width 100%) and centres on it: wider than the
     name, it overhangs it equally both sides; where the name is narrower
     than the line can be, it wraps within the name's width instead. */
  .title .meta {
    width: 0;
    min-width: 100%;
    text-align: center;
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .title .meta {
      white-space: normal;
    }
  }

  .title-h1 {
    font-stretch: 125%;
    font-size: clamp(64px, 11vw, 168px);
    line-height: 0.88;
    letter-spacing: -0.035em;
    margin-bottom: 24px;
  }

  .meta {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--on-deep);
  }

  /* Links, not buttons: without JavaScript they still jump to About and
     back to the top; with it, ui.ts takes over the click. */
  .dive-in,
  .surface {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    margin-top: 28px;
    min-height: 48px;
    padding: 0 26px;
    border: 1px solid rgba(234, 244, 246, 0.55);
    /* A gently rounded rectangle, not a pill: the fill must cover the
       button's whole box, which is what the contrast audit (and an eye
       reading the label against the water) sees. Dark enough to hold AA
       over the brightest surface water. */
    border-radius: 6px;
    background: rgba(4, 16, 28, 0.55);
    color: var(--on-deep);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .dive-in:hover,
  .surface:hover {
    background: rgba(4, 16, 28, 0.68);
  }

  /* About: one statement, at the scale of the film's own title cards. */
  .statement {
    margin: 0;
    max-width: 21ch;
    font-size: clamp(2rem, 4.6vw, 4rem);
    font-weight: 560;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
    color: var(--on-deep);
  }

  /* Every other section opens on a chapter card: its name set wide, in the
     title's own face, and its depth read off the dive (a measurement, so
     the mono). */
  .chapter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px clamp(18px, 2.4vw, 32px);
    margin-bottom: clamp(26px, 3.6vw, 48px);
  }

  .chapter-title {
    margin: 0;
    font-stretch: 125%;
    font-weight: 750;
    font-size: clamp(2.75rem, 7vw, 5.75rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--on-deep);
  }

  .chapter-depth {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(0.95rem, 1.3vw, 1.15rem);
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--on-deep-2);
  }

  .chapter-dek {
    margin: calc(-1 * clamp(14px, 2.4vw, 32px)) 0 clamp(28px, 4vw, 48px);
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    color: var(--on-deep-2);
  }

  /* Work: the dive log. One line runs down through each role's logged
     depth, each role a stop on the way down; the current one is the page's
     one lit thing. */
  .log {
    max-width: 62rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .log-row {
    position: relative;
    display: grid;
    grid-template-columns: clamp(4.5rem, 8vw, 6.5rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 clamp(16px, 3vw, 40px);
    padding: clamp(12px, 1.5vw, 18px) 0;
    border-top: 1px solid var(--line-deep);
  }

  .log-row:last-child {
    border-bottom: 1px solid var(--line-deep);
  }

  /* The profile line, one segment per row, joined mark to mark. */
  .log-row::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0.3rem;
    width: 1px;
    background: rgba(234, 244, 246, 0.32);
  }

  .log-row:first-child::before {
    top: 50%;
  }

  .log-row:last-child::before {
    bottom: 50%;
  }

  .log-depth {
    position: relative;
    margin: 0;
    padding-left: 1.4rem;
    font-family: var(--mono);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    color: var(--on-deep-2);
  }

  .log-mark {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.6rem;
    height: 0.6rem;
    margin-top: -0.3rem;
    border: 1px solid var(--on-deep-2);
    border-radius: 50%;
    background: #05141f;
  }

  .log-row:has(.log-now) .log-mark {
    border-color: var(--mark);
    background: var(--mark);
  }

  .log-org {
    margin: 0;
    font-stretch: 125%;
    font-weight: 700;
    font-size: clamp(1.45rem, 2.4vw, 2.1rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .log-now {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin-left: 0.6em;
    vertical-align: 0.3em;
    font-family: var(--mono);
    font-stretch: 100%;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mark);
  }

  .log-role {
    margin: 0.3rem 0 0;
    font-size: 1rem;
    color: var(--on-deep-2);
  }

  .log-meta {
    display: grid;
    justify-items: end;
    gap: 0.3rem;
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: var(--on-deep-2);
  }

  @media (max-width: 700px) {
    .log-row {
      grid-template-columns: 3.9rem minmax(0, 1fr);
      align-items: start;
    }

    .log-row::before {
      top: 0;
      bottom: 0;
    }

    .log-row:first-child::before {
      top: calc(clamp(12px, 1.5vw, 18px) + 0.6em);
    }

    .log-row:last-child::before {
      bottom: auto;
      height: calc(clamp(12px, 1.5vw, 18px) + 0.6em);
    }

    .log-depth {
      padding-top: 0.35rem;
    }

    .log-mark {
      top: 0.35rem;
      margin-top: 0.3rem;
    }

    .log-meta {
      grid-column: 2;
      display: flex;
      flex-wrap: wrap;
      justify-items: start;
      gap: 0.2rem 0.9rem;
      margin-top: 0.6rem;
      text-align: left;
    }
  }

  /* School and Projects: entries set as type on the water, two abreast. */
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 4.5vw, 60px) clamp(32px, 6vw, 96px);
  }

  .entry {
    margin: 0;
  }

  .entry-name {
    margin: 0;
    font-stretch: 125%;
    font-weight: 700;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .entry-line {
    max-width: 42ch;
    margin: 0.6rem 0 0;
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    line-height: 1.5;
    color: var(--on-deep);
  }

  .entry-meta {
    margin: 0.55rem 0 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--on-deep-2);
  }

  .entry--blank {
    padding-top: 0.6rem;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--on-deep-3);
  }

  /* Hobbies: the four pursuits, large, each with its one line. */
  .pursuits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(26px, 3.5vw, 48px) clamp(32px, 6vw, 96px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pursuit-name {
    margin: 0;
    font-stretch: 125%;
    font-weight: 700;
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .pursuit-line {
    max-width: 34ch;
    margin: 0.6rem 0 0;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.45;
    color: var(--on-deep-2);
  }

  @media (max-width: 700px) {
    .pair,
    .pursuits {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .more {
    margin: clamp(28px, 4vw, 44px) 0 0;
    font-family: var(--mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }

  .more a {
    color: var(--on-deep);
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(234, 244, 246, 0.45);
