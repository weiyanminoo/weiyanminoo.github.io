---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatRolePeriod } from '../lib/dates';

const title = 'Wei Yan — Computer Science, NUS';
const description =
  'Wei Yan, Computer Science at the National University of Singapore. Software engineering, mobile, product and automation.';

const roles = await getCollection('roles');
const allRoles = [...roles].sort((a, b) => b.data.start.getTime() - a.data.start.getTime());

const projects = await getCollection('projects');
const allProjects = [...projects].sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
---

<BaseLayout title={title} description={description} depth="column">
  <section class="zone-light">
    <h1>Wei Yan</h1>
    <div class="hero-note glass-card">
      <p class="lede">
        Computer Science at NUS. Four internships across four disciplines —
        automation, mobile, product, production support. I go deep in
        whichever one the problem needs.
      </p>
      <p class="meta">SINGAPORE &middot; CLASS OF 2027 &middot; NUS MERIT SCHOLAR</p>
    </div>
  </section>

  <section class="zone-light">
    <h2>The work</h2>
    <ul class="role-list">
      {
        allRoles.map((entry) => (
          <li class="glass-card">
            <span class="period">
              {formatRolePeriod(entry.data.start, entry.data.end, entry.data.current)}
            </span>
            <span class="org">{entry.data.org}</span>
            <span class="discipline">{entry.data.discipline}</span>
          </li>
        ))
      }
    </ul>
    <p class="more glass-card"><a href="/work">All five roles in detail</a></p>
  </section>

  <section class="zone-light">
    <h2>Built on my own time</h2>
    <ul class="project-list">
      {
        allProjects.map((entry) => (
          <li class="glass-card">
            <span class="name">{entry.data.name}</span>
            <span class="summary">{entry.data.summary}</span>
          </li>
        ))
      }
    </ul>
    <p class="more glass-card"><a href="/projects">Both projects in detail</a></p>
  </section>

  <section class="thermocline-section">
    <div id="thermocline" class="thermocline">
      <span class="thermocline-rule" aria-hidden="true"></span>
      <span class="thermocline-label">21M &middot; THERMOCLINE</span>
      <span class="thermocline-rule" aria-hidden="true"></span>
    </div>
  </section>

  <section class="zone-deep">
    <h2>Outside the work</h2>
    <div class="interests">
      <div class="interest glass-card">
        <h3>Diving</h3>
        <p>The reason this site descends as you read it.</p>
      </div>
      <div class="interest glass-card">
        <h3>Hiking</h3>
        <p>The other direction, and the opposite pace.</p>
      </div>
      <div class="interest glass-card">
        <h3>Keeping active</h3>
        <p>I will play most sports, enthusiastically and with mixed results.</p>
      </div>
    </div>
    <p class="more glass-card"><a href="/outside">More outside the work</a></p>
  </section>
</BaseLayout>

<style>
  /* The hero's body copy is the one place on the site where uncarded text
     was a binding contrast constraint: .lede/.meta are the softer
     --ink-2/--ink-3 tokens, they sit at 0-4m where the caustics multiply is
     at full strength (measured: this paragraph reads 4.64:1 with
     INTENSITY.caustics at 2.4 and 7.40:1 with it at 0 — see
     phase-7-report.md), and unlike every other body block on the site they
     had no card to sit on. Carded here at CARD_OPACITY.project (66%, must
     match intensity.ts by hand), the same treatment Home's own condensed
     list rows use. The <h1> above deliberately stays on bare water — it is
     large text (3:1, with ~3x headroom) and the mockup leaves its own hero
     heading floating free. Deviates from the mockup, whose .lede has no
     card: the mockup's caustics never run this strong. */
  .hero-note {
    max-width: 64ch;
    margin-top: 24px;
    padding: 24px 28px;
    background: color-mix(in srgb, var(--card-tint) 66%, transparent);
  }

  .lede {
    margin: 0;
    max-width: 60ch;
    font-size: clamp(17px, 2.2vw, 20px);
    color: var(--ink-2);
  }

  .meta {
    margin-top: 24px;
    margin-bottom: 0;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  h2 {
    font-size: clamp(22px, 3vw, 28px);
  }

  /* Gapped card stacks, water visible between them — same language as
     RoleEntry/ProjectCard's own cards, at CARD_OPACITY.project (66%, must
     match intensity.ts by hand) since these rows are the condensed,
     lighter-weight equivalent of those full-detail cards. */
  .role-list,
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .role-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 20px;
    min-height: 44px;
    padding: 12px 20px;
    background: color-mix(in srgb, var(--card-tint) 66%, transparent);
  }

  .role-list .period {
    flex: 0 0 auto;
    width: 13ch;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-3);
  }

  .role-list .org {
    font-weight: 700;
  }

  .role-list .discipline {
    color: var(--ink-2);
  }

  .project-list li {
    padding: 18px 20px;
    background: color-mix(in srgb, var(--card-tint) 66%, transparent);
  }

  .project-list .name {
    display: block;
    margin-bottom: 4px;
    font-weight: 700;
  }

  .project-list .summary {
    display: block;
    max-width: 60ch;
    color: var(--ink-2);
  }

  /* Carded for the same reason as .hero-note above: a 13px link is body
     text (4.5:1, not the 3:1 its neighbouring headings get), and these
     three sit at exactly the depths where bubbles, the shoal and — for the
     last one — snow are at full strength. Shrink-wrapped to the link rather
     than spanning the column, so the water still reads around it and the
     link keeps its existing underlined appearance. CARD_OPACITY.project
     (66%, must match intensity.ts by hand); the deep one inherits
     .zone-deep's own --card-tint, no JavaScript involved. */
  .more {
    width: fit-content;
    margin: 20px 0 0;
    padding: 10px 18px;
    background: color-mix(in srgb, var(--card-tint) 66%, transparent);
  }

  .more a {
    color: inherit;
    font-family: var(--mono);
    font-size: 13px;
  }

  .more a:hover {
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* The thermocline section is the passage itself, not a heading with
     margin around it: genuine top and bottom padding stand in for the
     distance actually swum through, so the divider sits inside real
     content space rather than being positioned by a pixel constant. The
     measured contrast floor for light text on deep water sits only a
     couple of metres past the thermocline (see depth.ts), and the actual
     canvas — dither, caustics and light shafts included — cuts it closer
     still, so the bottom padding is generous: it keeps the first deep-zone
     heading (Outside the work, which follows at ordinary section spacing)
     well clear of that margin rather than right at the boundary. */
  .thermocline-section {
    padding-block: 160px 260px;
  }

  .thermocline {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .thermocline-rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .thermocline-label {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--ink);
  }

  /* Stacked, not a row of three: each interest gets real room to breathe,
     which is also what gives the deep zone enough height to be scrolled
     through rather than glimpsed in one viewport. Each is its own deep
     glass card — see outside.astro's .topic for the matching treatment and
     CARD_OPACITY.deep (72%, must match intensity.ts by hand); no mockup
     precedent below the thermocline (finding 1). */
  .interests {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 32px;
  }

  .interest {
    padding: 28px;
    background: color-mix(in srgb, var(--card-tint) 72%, transparent);
  }

  .interest h3 {
    margin: 0 0 8px;
    font-size: 20px;
  }

  .interest p {
    margin: 0;
    max-width: 55ch;
    color: var(--ink-2);
  }
</style>
