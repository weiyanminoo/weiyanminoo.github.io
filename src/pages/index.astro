---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import RoleEntry from '../components/RoleEntry.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LogSlate from '../components/LogSlate.astro';
import { INTERESTS } from '../lib/interests';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/wei-yan-diving.png';

const title = 'Wei Yan — Computer Science, NUS';
const description =
  'Wei Yan, Computer Science at the National University of Singapore. Software engineering, mobile, product and automation.';

const roles = await getCollection('roles');
const allRoles = [...roles].sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
const renderedRoles = await Promise.all(allRoles.map((entry) => render(entry)));

const projects = await getCollection('projects');
const allProjects = [...projects].sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
const renderedProjects = await Promise.all(allProjects.map((entry) => render(entry)));
---

<BaseLayout title={title} description={description} depth="column">
  <section class="hero zone-light">
    <h1 class="hero-h1">Wei Yan</h1>
    <div class="hero-row">
      <div class="hero-note glass-card">
        <p class="lede">
          Driven by curiousity and a growth mindset, I love tackling complex problems and working on innovative solutions.
        </p>
        <p class="meta">SINGAPORE &middot; NATIONAL UNIVERSITY OF SINGAPORE &middot; COMPUTER SCIENCE</p>
      </div>
      <Image
        class="portrait"
        src={portrait}
        alt="Wei Yan underwater in scuba gear, giving a shaka sign to the camera"
        widths={[320, 480, 715]}
        sizes="(max-width: 860px) 62vw, 340px"
        loading="eager"
      />
    </div>
  </section>

  <section class="zone-light">
    <SectionHead label="DIVE LOG — WORK" depth="5 M" />
    <div class="roles">
      {
        allRoles.map((entry, i) => {
          const { Content } = renderedRoles[i];
          return (
            <RoleEntry
              org={entry.data.org}
              role={entry.data.role}
              team={entry.data.team}
              discipline={entry.data.discipline}
              start={entry.data.start}
              end={entry.data.end}
              current={entry.data.current}
              depth={entry.data.depth}
              tags={entry.data.tags}
              open={i === 0}
            >
              <Content />
            </RoleEntry>
          );
        })
      }
    </div>
    <p class="more glass-card"><a href="/work">All five roles in detail</a></p>
  </section>

  <section class="zone-light">
    <SectionHead label="BUILT ON MY OWN TIME" depth="14 M" />
    <div class="projects">
      {
        allProjects.map((entry, i) => {
          const { Content } = renderedProjects[i];
          return (
            <ProjectCard
              name={entry.data.name}
              kind={entry.data.kind}
              start={entry.data.start}
              ongoing={entry.data.ongoing}
              url={entry.data.url}
              summary={entry.data.summary}
              outcome={entry.data.outcome}
              tags={entry.data.tags}
            >
              <Content />
            </ProjectCard>
          );
        })
      }
    </div>
    <p class="more glass-card"><a href="/projects">Both projects in detail</a></p>
  </section>

  <div class="thermocline-section">
    <div id="thermocline" class="thermocline">
      <span class="thermocline-rule" aria-hidden="true"></span>
      <span class="thermocline-label">21M &middot; THERMOCLINE</span>
      <span class="thermocline-rule" aria-hidden="true"></span>
    </div>
  </div>

  <section class="zone-deep">
    <SectionHead label="OUTSIDE THE WORK" depth="24 M" />
    <div class="interests">
      {
        INTERESTS.map((interest) => (
          <div class="interest glass-card">
            <h3>{interest.title}</h3>
            <p class="line">{interest.line}</p>
            <p>{interest.body}</p>
            <LogSlate fields={interest.fields} />
          </div>
        ))
      }
    </div>
    <p class="more glass-card"><a href="/outside">More outside the work</a></p>
  </section>
</BaseLayout>

<style>
  /* The hero's body copy is the one place on the site where uncarded text
     was a binding contrast constraint: .lede/.meta are the softer
     --ink-2/--ink-3 tokens, they sit at 0-4m where the caustics multiply is
     at full strength (measured: this paragraph reads 4.64:1 with
     INTENSITY.caustics at 2.4 and 7.40:1 with it at 0 — see
     phase-7-report.md), and unlike every other body block on the site they
     had no card to sit on. Carded here at CARD_OPACITY.project (66%, must
     match intensity.ts by hand), the same treatment Home's own condensed
     list rows use. The <h1> above deliberately stays on bare water — it is
     large text (3:1, with ~3x headroom) and the mockup leaves its own hero
     heading floating free. Deviates from the mockup, whose .lede has no
     card: the mockup's caustics never run this strong. */
  /* Mockup's .hero: padding-top 124px / padding-bottom 128px, overriding
     base.css's shared `section{padding-block:112px}` exactly as the
     mockup's own .hero rule overrides its `section` rule. */
  .hero {
    padding-top: 124px;
    padding-bottom: 128px;
  }

  /* Mockup's .hero h1: clamp(58px,9.2vw,132px)/800/.88/-.04em, scoped to
     just this page's own h1 (base.css's shared h1 rule stays the smaller
     site-wide default that Work/Projects/Outside's plain page-title h1s
     still use — the mockup only ever has the one hero heading). */
  .hero-h1 {
    font-size: clamp(58px, 9.2vw, 132px);
    line-height: 0.88;
    letter-spacing: -0.04em;
  }

  .hero-note {
    max-width: 64ch;
    margin-top: 24px;
    padding: 24px 28px;
    background: color-mix(in srgb, var(--card-tint) 58%, transparent);
  }

  .lede {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(17px, 2.1vw, 23px);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .meta {
    margin-top: 24px;
    margin-bottom: 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* Phase 8: Home carries the full log and the full projects, not the
     condensed period/org/discipline rows it used to — same components,
     same card language and same gaps as /work's .roles and /projects'
     .projects, which is the point (phase-7-9-brief.md 8.2: reuse the
     components, do not fork a second copy for Home). */
  .roles {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 32px;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 18px;
    margin-top: 32px;
  }

  /* Carded for the same reason as .hero-note above: a 13px link is body
     text (4.5:1, not the 3:1 its neighbouring headings get), and these
     three sit at exactly the depths where bubbles, the shoal and — for the
     last one — snow are at full strength. Shrink-wrapped to the link rather
     than spanning the column, so the water still reads around it and the
     link keeps its existing underlined appearance. CARD_OPACITY.project
     (66%, must match intensity.ts by hand); the deep one inherits
     .zone-deep's own --card-tint, no JavaScript involved. */
  .more {
    width: fit-content;
    margin: 20px 0 0;
    padding: 0 18px;
    background: color-mix(in srgb, var(--card-tint) 58%, transparent);
  }

  /* The link, not the paragraph, carries the height: measured at 16.0px
     tall before this — the pill's own 10px block padding is not part of
     the target, so the hit area was the bare line box. */
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    font-family: var(--mono);
    font-size: 13px;
  }

  .more a:hover {
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* The thermocline is a passage, not a rule: genuine top and bottom
     padding stand in for the distance actually swum through. A plain <div>,
     not a <section>, so base.css's `section{padding-block:112px}` does not
     stack on top of its own padding — the mockup's .thermo is likewise not
     a section, and its .thermo__in carries the whole passage. Padding is
     the mockup's clamp(130px,19vh,210px), replacing the asymmetric
     160/260 that predated the Phase 8 rhythm: the page is now ~1.6x taller
     for the same 0-32m range, so a metre of depth costs far more scrolling
     and the extra bottom margin that used to keep the first deep-zone
     heading clear of the contrast boundary is no longer doing that work —
     verified by the contrast sweep, not assumed. */
  .thermocline-section {
    padding-block: clamp(130px, 19vh, 210px);
  }

  .thermocline {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .thermocline-rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .thermocline-label {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--ink);
  }

  /* Stacked, not a row of three: each interest gets real room to breathe,
     which is also what gives the deep zone enough height to be scrolled
     through rather than glimpsed in one viewport. Each is its own deep
     glass card — see outside.astro's .topic for the matching treatment and
     CARD_OPACITY.deep (72%, must match intensity.ts by hand); no mockup
     precedent below the thermocline (finding 1). */
  .interests {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 32px;
  }

  .interest {
    padding: 28px;
    background: color-mix(in srgb, var(--card-tint) 72%, transparent);
  }

  .interest h3 {
    margin: 0 0 8px;
    font-size: 20px;
  }

  .interest p {
    max-width: 55ch;
    color: var(--ink-2);
  }

  .interest .line {
    font-size: 17px;
    color: var(--on-deep-2);
  }

  /* The portrait floats in the water beside the intro rather than sitting in a
     card — it is a cut-out, so the water is its background. No border or
     surface: anything drawn round it would read as a frame and break that. */
  .hero-row {
    display: flex;
    align-items: flex-start;
    gap: 40px;
  }

  .hero-row .hero-note {
    flex: 1 1 auto;
    min-width: 0;
  }

  .portrait {
    flex: 0 0 auto;
    width: 340px;
    height: auto;
    filter: drop-shadow(0 18px 40px rgba(11, 42, 58, 0.28));
  }

  @media (max-width: 860px) {
    .hero-row {
      flex-direction: column-reverse;
      align-items: center;
      gap: 28px;
    }

    .portrait {
      width: min(62vw, 300px);
    }
  }
</style>
