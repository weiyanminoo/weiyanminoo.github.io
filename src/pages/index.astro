---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import RoleEntry from '../components/RoleEntry.astro';
import SchoolCard from '../components/SchoolCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PlaceholderCard from '../components/PlaceholderCard.astro';
import { HOBBIES } from '../lib/hobbies';
import { SCHOOL_SLOTS, PROJECT_SLOTS } from '../lib/slots';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/home-diving.png';

const title = 'Wei Yan — Computer Science, NUS';
const description =
  'Wei Yan, Computer Science at the National University of Singapore. Software engineering, mobile, product and automation.';

// No render() anywhere on this page. Home shows each record's summary row
// and nothing more — the markdown bodies are what /work, /school and
// /projects are for, so this page never asks for them.
const roles = await getCollection('roles');
const allRoles = [...roles].sort((a, b) => b.data.start.getTime() - a.data.start.getTime());

const school = await getCollection('school');
const allSchool = [...school].sort((a, b) => a.data.order - b.data.order);

const projects = await getCollection('projects');
const allProjects = [...projects].sort((a, b) => b.data.start.getTime() - a.data.start.getTime());

const schoolBlanks = Math.max(0, SCHOOL_SLOTS - allSchool.length);
const projectBlanks = Math.max(0, PROJECT_SLOTS - allProjects.length);

// Depth markers. MEASURED against the rendered page, not spaced by eye:
// each is depthForColumn() evaluated at that section heading's own document
// position — the depth of the water the canvas actually paints behind it —
// so a reader who notices that the label says 12 M and the water there is
// the 12 M colour is right.
//
// They are therefore unevenly spaced, because the sections are unevenly
// long: Work is five cards and School is two, so Work occupies nearly twice
// the column School does and the gap between their markers is not the gap
// between School's and Projects'. Evenly spaced markers would have been a
// fiction.
//
// Measured at 1440x900 and 375x812 respectively:
//   Work      5.74m / 6.00m
//   School   12.12m / 11.67m
//   Projects 15.67m / 14.92m  -> 15, whose mean error across the two
//                               viewports is half that of 16
//   Hobbies  23.49m / 22.60m
// The two viewports differ because the layout reflows, so each marker is
// one value standing for a small range. Deliberately NOT the same mapping
// as the rail's readout, which answers "how far have I descended" and is
// documented in depth.ts as not agreeing with this one everywhere.
//
// Re-measure if a section's length changes substantially. Nothing breaks if
// these go stale — the water is pinned to the thermocline divider and
// re-derives on its own — but a stale number here would contradict the
// colour behind it.
const DEPTH_MARKS = {
  work: '6 M',
  school: '12 M',
  projects: '15 M',
  hobbies: '23 M',
};
---

<BaseLayout title={title} description={description} depth="column">
  <section class="hero zone-light">
    <div class="hero-row">
      <div class="hero-left">
        <h1 class="hero-h1">Wei Yan</h1>
        <div class="hero-note glass-card">
          <p class="lede">
            Driven by curiousity and a growth mindset, I love tackling complex problems and working
            on innovative solutions.
          </p>
          <p class="meta">
            SINGAPORE &middot; NATIONAL UNIVERSITY OF SINGAPORE &middot; COMPUTER SCIENCE
          </p>
        </div>
      </div>
      <div class="portrait-wrap">
        <Image
          class="portrait"
          src={portrait}
          alt="Wei Yan underwater in scuba gear, giving a shaka sign to the camera"
          widths={[380, 560, 1011]}
          sizes="(max-width: 860px) 70vw, 380px"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="zone-light">
    <SectionHead label="DIVE LOG — WORK" depth={DEPTH_MARKS.work} />
    <div class="roles">
      {
        allRoles.map((entry) => (
          <RoleEntry
            org={entry.data.org}
            role={entry.data.role}
            team={entry.data.team}
            discipline={entry.data.discipline}
            start={entry.data.start}
            end={entry.data.end}
            current={entry.data.current}
            depth={entry.data.depth}
            tags={entry.data.tags}
            expandable={false}
          />
        ))
      }
    </div>
    <p class="more glass-card"><a href="/work">All five roles in detail</a></p>
  </section>

  <section class="zone-light">
    <SectionHead label="DIVE LOG — SCHOOL" depth={DEPTH_MARKS.school} />
    <div class="cards">
      {
        allSchool.map((entry) => (
          <SchoolCard
            institution={entry.data.institution}
            qualification={entry.data.qualification}
            period={entry.data.period}
            summary={entry.data.summary}
            notes={entry.data.notes}
          />
        ))
      }
      {
        Array.from({ length: schoolBlanks }, () => (
          <PlaceholderCard label="A second school, not yet added" />
        ))
      }
    </div>
    <p class="more glass-card"><a href="/school">Where I have studied</a></p>
  </section>

  <section class="zone-light">
    <SectionHead label="BUILT ON MY OWN TIME" depth={DEPTH_MARKS.projects} />
    <div class="cards">
      {
        allProjects.map((entry) => (
          <ProjectCard
            name={entry.data.name}
            kind={entry.data.kind}
            start={entry.data.start}
            ongoing={entry.data.ongoing}
            url={entry.data.url}
            summary={entry.data.summary}
            outcome={entry.data.outcome}
            tags={entry.data.tags}
          />
        ))
      }
      {
        Array.from({ length: projectBlanks }, () => (
          <PlaceholderCard label="A project not yet added" />
        ))
      }
    </div>
    <p class="more glass-card"><a href="/projects">Every project in detail</a></p>
  </section>

  <div class="thermocline-section">
    <div id="thermocline" class="thermocline">
      <span class="thermocline-rule" aria-hidden="true"></span>
      <span class="thermocline-label">21M &middot; THERMOCLINE</span>
      <span class="thermocline-rule" aria-hidden="true"></span>
    </div>
  </div>

  <section class="zone-deep">
    <SectionHead label="OUTSIDE THE WORK" depth={DEPTH_MARKS.hobbies} />
    <div class="hobbies">
      {
        HOBBIES.map((hobby) => (
          <div class="hobby glass-card">
            <h3>{hobby.title}</h3>
            {hobby.line && <p class="line">{hobby.line}</p>}
          </div>
        ))
      }
    </div>
    <p class="more glass-card"><a href="/hobbies">More outside the work</a></p>
  </section>
</BaseLayout>

<style>
  /* The hero's body copy is the one place on the site where uncarded text
     was a binding contrast constraint: .lede/.meta are the softer
     --ink-2/--ink-3 tokens, they sit at 0-4m where the caustics multiply is
     at full strength (measured: this paragraph reads 4.64:1 with
     INTENSITY.caustics at 2.4 and 7.40:1 with it at 0 — see
     phase-7-report.md), and unlike every other body block on the site they
     had no card to sit on. Carded here at CARD_OPACITY.project (66%, must
     match intensity.ts by hand). The <h1> above deliberately stays on bare
     water — it is large text (3:1, with ~3x headroom) and the mockup leaves
     its own hero heading floating free. */
  /* Mockup's .hero: padding-top 124px / padding-bottom 128px, overriding
     base.css's shared `section{padding-block:112px}` exactly as the
     mockup's own .hero rule overrides its `section` rule. */
  .hero {
    padding-top: 124px;
    padding-bottom: 128px;
  }

  /* Mockup's .hero h1: clamp(58px,9.2vw,132px)/800/.88/-.04em, scoped to
     just this page's own h1 (base.css's shared h1 rule stays the smaller
     site-wide default that the tabs' plain page-title h1s still use — the
     mockup only ever has the one hero heading). */
  .hero-h1 {
    font-size: clamp(58px, 9.2vw, 132px);
    line-height: 0.88;
    letter-spacing: -0.04em;
  }

  .hero-note {
    max-width: 64ch;
    margin-top: 24px;
    padding: 24px 28px;
    background: color-mix(in srgb, var(--card-tint) 58%, transparent);
  }

  .lede {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(17px, 2.1vw, 23px);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .meta {
    margin-top: 24px;
    margin-bottom: 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* Mockup's .log: a gapped stack of cards, water visible between them.
     Home's are RoleEntry's compact branch — the log row and nothing else,
     since the bullets and figures live on /work now. */
  .roles {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 32px;
  }


  /* Carded for the same reason as .hero-note above: a 13px link is body
     text (4.5:1, not the 3:1 its neighbouring headings get), and these sit
     at exactly the depths where bubbles, the shoal and — for the last one —
     snow are at full strength. Shrink-wrapped to the link rather than
     spanning the column, so the water still reads around it and the link
     keeps its existing underlined appearance. CARD_OPACITY.project (66%,
     must match intensity.ts by hand); the deep one inherits .zone-deep's
     own --card-tint, no JavaScript involved. */
  .more {
    width: fit-content;
    margin: 20px 0 0;
    padding: 0 18px;
    background: color-mix(in srgb, var(--card-tint) 58%, transparent);
  }

  /* The link, not the paragraph, carries the height: measured at 16.0px
     tall before this — the pill's own 10px block padding is not part of
     the target, so the hit area was the bare line box. */
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    font-family: var(--mono);
    font-size: 13px;
  }

  .more a:hover {
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* The thermocline is a passage, not a rule: genuine top and bottom
     padding stand in for the distance actually swum through. A plain <div>,
     not a <section>, so base.css's `section{padding-block:112px}` does not
     stack on top of its own padding — the mockup's .thermo is likewise not
     a section, and its .thermo__in carries the whole passage. */
  .thermocline-section {
    padding-block: clamp(130px, 19vh, 210px);
  }

  .thermocline {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .thermocline-rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .thermocline-label {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--ink);
  }

  /* Four small cards in a row rather than the stacked, slate-bearing blocks
     this section used to carry: Home names the hobbies and /hobbies holds
     whatever detail exists for them. Each is its own deep glass card at
     CARD_OPACITY.deep (72%, must match intensity.ts by hand); no mockup
     precedent below the thermocline. */
  .hobbies {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 18px;
    margin-top: 32px;
  }

  .hobby {
    padding: 28px;
    background: color-mix(in srgb, var(--card-tint) 72%, transparent);
  }

  .hobby h3 {
    margin: 0;
    font-size: 22px;
  }

  /* --on-deep-2 explicitly rather than --ink-2: .zone-deep remaps --ink-2
     to exactly this, so the two are the same colour here — named directly
     because this card only ever renders in the deep zone. */
  .hobby .line {
    margin: 10px 0 0;
    font-size: 16px;
    color: var(--on-deep-2);
  }

  /* The portrait floats in the water beside the intro rather than sitting in a
     card — it is a cut-out, so the water is its background. No border or
     surface: anything drawn round it would read as a frame and break that. */
  /* The portrait stands the full height of the heading plus the intro card
     beside it, so the two columns end level. The left column sets the row's
     height; the image stretches to it and takes whatever width its aspect
     ratio then asks for. */
  .hero-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    gap: 44px;
  }

  .hero-left {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* A grid item gets a definite height from the row, which a percentage height
     on the image can actually resolve against — inside a flex item with auto
     height it collapsed to zero. */
  .portrait-wrap {
    position: relative;
    width: clamp(210px, 26vw, 360px);
  }

  /* No card or frame — it is a cut-out, so the water is its background. */
  /* Absolutely positioned so the image contributes NO intrinsic height: the
     heading and card decide how tall the row is, and the image is sized to
     them. Laid out in flow it did the opposite, driving the row 142px taller
     than the text and leaving dead space under the card. */
  .portrait {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    display: block;
    filter: drop-shadow(0 18px 40px rgba(11, 42, 58, 0.28));
  }

  @media (max-width: 860px) {
    .hero-row {
      grid-template-columns: minmax(0, 1fr);
      align-items: center;
      gap: 28px;
    }

    .portrait-wrap {
      position: static;
      width: min(70vw, 320px);
      justify-self: center;
    }

    .portrait {
      position: static;
      height: auto;
    }
  }
</style>
