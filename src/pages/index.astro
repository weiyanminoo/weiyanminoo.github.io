---
import DiveLayout from '../layouts/DiveLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import RoleEntry from '../components/RoleEntry.astro';
import SchoolCard from '../components/SchoolCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PlaceholderCard from '../components/PlaceholderCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { HOBBIES } from '../lib/hobbies';
import { SCHOOL_SLOTS, PROJECT_SLOTS } from '../lib/slots';
import { SECTION_PROGRESS, diveStateAt } from '../scripts/dive/timeline';
import type { SectionId } from '../scripts/dive/types';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/home-diving.png';

const title = 'Wei Yan — Computer Science, NUS';
const description =
  'Wei Yan, Computer Science at the National University of Singapore. Software engineering, mobile, product and automation.';

// No render() anywhere on this page. The landing shows each record's
// summary row and nothing more — the markdown bodies are what /work,
// /school and /projects are for.
const roles = await getCollection('roles');
const allRoles = [...roles].sort((a, b) => b.data.start.getTime() - a.data.start.getTime());

const school = await getCollection('school');
const allSchool = [...school].sort((a, b) => a.data.order - b.data.order);

const projects = await getCollection('projects');
const allProjects = [...projects].sort((a, b) => b.data.start.getTime() - a.data.start.getTime());

const schoolBlanks = Math.max(0, SCHOOL_SLOTS - allSchool.length);
const projectBlanks = Math.max(0, PROJECT_SLOTS - allProjects.length);

// Each section's depth label is the film's own depth at that section, read
// from the same timeline the scene renders — so the label, the depth gauge
// and the water behind the text always agree.
const depthLabel = (id: SectionId) => `${Math.round(diveStateAt(SECTION_PROGRESS[id]).depth)} M`;

// Scroll room between stations, in viewport heights, so the film has time
// between summaries (spec §6). Only applied when the film runs.
const GAP_VH = {
  afterTitle: 80,
  afterAbout: 140,
  afterWork: 100,
  afterSchool: 100,
  afterProjects: 140,
  afterHobbies: 100,
  tail: 60,
};

const still = (id: SectionId) => `/dive/stills/${id}.jpg`;
---

<DiveLayout title={title} description={description}>
  <section class="station title" data-section="title" id="title">
    <img class="still" src={still('title')} alt="" loading="lazy" decoding="async" />
    <div class="content container">
      <h1 class="title-h1" tabindex="-1">Wei Yan</h1>
      <p class="meta">
        SINGAPORE &middot; NATIONAL UNIVERSITY OF SINGAPORE &middot; COMPUTER SCIENCE
      </p>
      <button class="dive-in" type="button">Dive in</button>
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.afterTitle}`} aria-hidden="true"></div>

  <section class="station about" data-section="about" id="about" tabindex="-1">
    <img class="still" src={still('about')} alt="" loading="lazy" decoding="async" />
    <div class="content container about-row">
      <p class="lede">
        Driven by curiousity and a growth mindset, I love tackling complex problems and working on
        innovative solutions.
      </p>
      <Image
        class="portrait"
        src={portrait}
        alt="Wei Yan underwater in scuba gear, giving a shaka sign to the camera"
        widths={[470, 700, 917]}
        sizes="(max-width: 860px) min(100vw, 420px), 420px"
        loading="lazy"
      />
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.afterAbout}`} aria-hidden="true"></div>

  <section class="station" data-section="work" id="work">
    <img class="still" src={still('work')} alt="" loading="lazy" decoding="async" />
    <div class="content container">
      <SectionHead label="DIVE LOG — WORK" depth={depthLabel('work')} />
      <div class="roles">
        {
          allRoles.map((entry) => (
            <RoleEntry
              org={entry.data.org}
              role={entry.data.role}
              team={entry.data.team}
              discipline={entry.data.discipline}
              start={entry.data.start}
              end={entry.data.end}
              current={entry.data.current}
              depth={entry.data.depth}
              tags={entry.data.tags}
              expandable={false}
            />
          ))
        }
      </div>
      <p class="more"><a href="/work">All five roles in detail</a></p>
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.afterWork}`} aria-hidden="true"></div>

  <section class="station" data-section="school" id="school">
    <img class="still" src={still('school')} alt="" loading="lazy" decoding="async" />
    <div class="content container">
      <SectionHead label="DIVE LOG — SCHOOL" depth={depthLabel('school')} />
      <div class="cards">
        {
          allSchool.map((entry) => (
            <SchoolCard
              institution={entry.data.institution}
              qualification={entry.data.qualification}
              period={entry.data.period}
              summary={entry.data.summary}
              notes={entry.data.notes}
            />
          ))
        }
        {
          Array.from({ length: schoolBlanks }, () => (
            <PlaceholderCard label="A second school, not yet added" />
          ))
        }
      </div>
      <p class="more"><a href="/school">Where I have studied</a></p>
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.afterSchool}`} aria-hidden="true"></div>

  <section class="station" data-section="projects" id="projects">
    <img class="still" src={still('projects')} alt="" loading="lazy" decoding="async" />
    <div class="content container">
      <SectionHead label="BUILT ON MY OWN TIME" depth={depthLabel('projects')} />
      <div class="cards">
        {
          allProjects.map((entry) => (
            <ProjectCard
              name={entry.data.name}
              kind={entry.data.kind}
              start={entry.data.start}
              ongoing={entry.data.ongoing}
              url={entry.data.url}
              summary={entry.data.summary}
              outcome={entry.data.outcome}
              tags={entry.data.tags}
            />
          ))
        }
        {
          Array.from({ length: projectBlanks }, () => (
            <PlaceholderCard label="A project not yet added" />
          ))
        }
      </div>
      <p class="more"><a href="/projects">Every project in detail</a></p>
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.afterProjects}`} aria-hidden="true"></div>

  <section class="station" data-section="hobbies" id="hobbies">
    <img class="still" src={still('hobbies')} alt="" loading="lazy" decoding="async" />
    <div class="content container">
      <SectionHead label="OUTSIDE THE WORK" depth={depthLabel('hobbies')} />
      <div class="hobbies">
        {
          HOBBIES.map((hobby) => (
            <div class="hobby">
              <h3>{hobby.title}</h3>
              {hobby.line && <p class="line">{hobby.line}</p>}
            </div>
          ))
        }
      </div>
      <p class="more"><a href="/hobbies">More outside the work</a></p>
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.afterHobbies}`} aria-hidden="true"></div>

  <section class="station contact" data-section="contact" id="contact">
    <img class="still" src={still('contact')} alt="" loading="lazy" decoding="async" />
    <div class="content">
      <SiteFooter />
      <div class="container">
        <button class="surface" type="button">Surface</button>
      </div>
    </div>
  </section>

  <div class="gap" style={`--gap: ${GAP_VH.tail}`} aria-hidden="true"></div>
</DiveLayout>

<script>
  import { mountDive } from '../scripts/dive/index';
  import { wireUi } from '../scripts/dive/ui';

  const root = document.querySelector('main');
  if (root) {
    // The controls work with or without the film (reduced motion, no WebGL).
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dive = await mountDive(root);
    wireUi({
      getLenis: () => dive?.lenis ?? null,
      onDiveIn: () => dive?.startEntry(),
      reducedMotion,
    });
  }
</script>

<style>
  /* Light ink and no glass for everything on the landing: the shared
     components were built for frosted cards over pale water, and spec §6
     bans frosted cards over the film. Overriding their tokens here, rather
     than editing them, keeps the static pages untouched. */
  main {
    --ink: var(--on-deep);
    --ink-2: var(--on-deep-2);
    --ink-3: var(--on-deep-3);
    --line: var(--line-deep);
    --focus: var(--mark);
    --card-tint: transparent;
    --card-border: transparent;
    --card-shadow: transparent;
    --card-shadow-hover: transparent;
    color: var(--on-deep);
  }

  main :global(.glass-card) {
    backdrop-filter: none;
  }

  /* Without the film the spacers collapse, so no-JS and reduced-motion
     readers get a compact page. html.dive-js is set before first paint by
     DiveLayout's inline script. */
  .gap {
    height: 6vh;
  }

  :global(html.dive-js) .gap {
    height: calc(var(--gap) * 1vh);
  }

  .station {
    position: relative;
    isolation: isolate;
  }

  /* The scrim: a soft darkening behind each station's text instead of a
     card — no edges, nothing to read as glass. CSS rather than shader so it
     also works without the film (plan deviation, ledgered). */
  .station::before {
    content: '';
    position: absolute;
    inset: -12% -4%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 75% 65% at 50% 50%,
      rgba(5, 20, 35, 0.55),
      transparent 70%
    );
  }

  /* Poster frames behind each station when the film is not running. Hidden
     from first paint whenever the film is expected (html.dive-js), so a
     lazy image hidden by display:none is never fetched on the film path;
     index.ts adds .dive-off if the film stops (e.g. a lost GPU context). */
  .still {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(html.dive-js:not(.dive-off)) .still {
    display: none;
  }

  /* The focus pull (spec §6): text sharpens as its station reaches the
     viewport's centre. --pull is set per station by index.ts; it defaults to
     1 (sharp), so without the film nothing is ever blurred. Not named
     --focus — that token is the focus-ring colour. */
  .content {
    filter: blur(calc((1 - var(--pull, 1)) * 6px));
    transform: translateY(calc((1 - var(--pull, 1)) * 24px));
  }

  @media (prefers-reduced-motion: reduce) {
    .content {
      filter: none;
      transform: none;
    }
  }

  /* The title and About take focus only programmatically (Surface and Dive
     in land on them); they are not controls, so no ring — as main's own
     skip-link target in BaseLayout. */
  [tabindex='-1']:focus-visible {
    outline: none;
  }

  .title {
    min-height: 92vh;
    display: flex;
    align-items: center;
  }

  .title-h1 {
    font-stretch: 125%;
    font-size: clamp(64px, 11vw, 168px);
    line-height: 0.88;
    letter-spacing: -0.035em;
    margin-bottom: 24px;
  }

  .meta {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--on-deep);
  }

  .dive-in,
  .surface {
    margin-top: 28px;
    min-height: 48px;
    padding: 0 26px;
    border: 1px solid rgba(234, 244, 246, 0.55);
    border-radius: 999px;
    background: rgba(4, 16, 28, 0.3);
    color: var(--on-deep);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .dive-in:hover,
  .surface:hover {
    background: rgba(4, 16, 28, 0.5);
  }

  .about-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    gap: 48px;
    align-items: center;
  }

  .lede {
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.45;
    max-width: 30ch;
  }

  .portrait {
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  @media (max-width: 860px) {
    .about-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .roles {
    display: grid;
    gap: 2px;
    margin-top: 24px;
  }

  .more {
    margin-top: 28px;
    font-family: var(--mono);
    font-size: 13px;
  }

  .more a {
    color: inherit;
    text-underline-offset: 5px;
  }

  .hobbies {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 48px;
    margin-top: 28px;
  }

  @media (max-width: 700px) {
    .hobbies {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .hobby h3 {
    margin: 0 0 6px;
    font-size: 22px;
  }

  .hobby .line {
    color: var(--on-deep-2);
  }

  .contact :global(.site-footer) {
    background: none;
  }
</style>
