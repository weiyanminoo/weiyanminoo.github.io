---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogSlate from '../components/LogSlate.astro';
import SectionHead from '../components/SectionHead.astro';
import { INTERESTS } from '../lib/interests';

const title = 'Outside — Wei Yan';
const description = "What Wei Yan does outside of coursework and internships.";
---

<BaseLayout title={title} description={description} depth="deep">
  <section>
    <h1>Outside</h1>
    <SectionHead label="OUTSIDE THE WORK" depth="24 M" />
  </section>

  {/* Copy lives in src/lib/interests.ts — Home's own Outside section
      renders the same three topics (phase-7-9-brief.md 8.2), so it is one
      table rather than two hand-kept copies of the same prose. */}
  {
    INTERESTS.map((interest) => (
      <section class="topic glass-card">
        <h2>{interest.title}</h2>
        <p class="line">{interest.line}</p>
        <p>{interest.body}</p>
        <LogSlate fields={interest.fields} />
      </section>
    ))
  }
</BaseLayout>

<style>
  /* Card background — see base.css's .glass-card for the shared
     blur/border/shadow/transition, and intensity.ts's CARD_OPACITY.deep
     (72%) for the opacity this must match by hand. No mockup precedent for
     a deep-zone card (finding 1) — the mockup's own .field__row has no
     background at all — this exists because our snow effect runs behind
     this text at a strength the mockup's deep zone never has to survive
     uncarded; see phase-7-report.md. */
  .topic {
    margin-top: 32px;
    padding: 32px;
    background: color-mix(in srgb, var(--card-tint) 72%, transparent);
  }

  .topic + .topic {
    margin-top: 18px;
  }

  .line {
    font-size: 17px;
    color: var(--on-deep-2);
  }
</style>
