---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PlaceholderCard from '../components/PlaceholderCard.astro';
import SectionHead from '../components/SectionHead.astro';
import { PROJECT_SLOTS } from '../lib/slots';
import { getCollection, render } from 'astro:content';

const title = 'Projects — Wei Yan';
const description = "Wei Yan's personal and side projects.";

const projects = await getCollection('projects');
const sorted = [...projects].sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
const rendered = await Promise.all(sorted.map((entry) => render(entry)));

const blanks = Math.max(0, PROJECT_SLOTS - sorted.length);
---

<BaseLayout title={title} description={description}>
  <section>
    <h1>Projects</h1>
    <SectionHead label="BUILT ON MY OWN TIME" />
    <div class="cards">
      {
        sorted.map((entry, i) => {
          const { Content } = rendered[i];
          return (
            <ProjectCard
              name={entry.data.name}
              kind={entry.data.kind}
              start={entry.data.start}
              ongoing={entry.data.ongoing}
              url={entry.data.url}
              summary={entry.data.summary}
              outcome={entry.data.outcome}
              tags={entry.data.tags}
              detailed
            >
              <Content />
            </ProjectCard>
          );
        })
      }
      {
        Array.from({ length: blanks }, () => <PlaceholderCard label="A project not yet added" />)
      }
    </div>
  </section>
</BaseLayout>

