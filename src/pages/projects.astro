---
import StaticLayout from '../layouts/StaticLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PlaceholderCard from '../components/PlaceholderCard.astro';
import SectionHead from '../components/SectionHead.astro';
import { PROJECT_SLOTS } from '../lib/slots';
import { getCollection, render } from 'astro:content';
import { byProjectRecency } from '../lib/dates';

const title = 'Projects — Wei Yan';
const description = "Wei Yan's personal and side projects.";

const projects = await getCollection('projects');
// Projects with a longer write-up get a link to it on their card.
const storied = new Set((await getCollection('stories')).map((s) => s.data.project.id));
const sorted = [...projects].sort((a, b) => byProjectRecency(a.data, b.data));
const rendered = await Promise.all(sorted.map((entry) => render(entry)));

const blanks = Math.max(0, PROJECT_SLOTS - sorted.length);
---

<StaticLayout title={title} description={description}>
  <section>
    <h1>Projects</h1>
    <SectionHead label="BUILT ON MY OWN TIME" />
    <div class="cards">
      {
        sorted.map((entry, i) => {
          const { Content } = rendered[i];
          return (
            <ProjectCard
              name={entry.data.name}
              kind={entry.data.kind}
              start={entry.data.start}
              end={entry.data.end}
              ongoing={entry.data.ongoing}
              url={entry.data.url}
              story={storied.has(entry.id) ? `/projects/${entry.id}` : undefined}
              summary={entry.data.summary}
              outcome={entry.data.outcome}
              tags={entry.data.tags}
              detailed
            >
              <Content />
            </ProjectCard>
          );
        })
      }
      {
        Array.from({ length: blanks }, () => <PlaceholderCard label="A project not yet added" />)
      }
    </div>
  </section>
</StaticLayout>

