---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoleEntry from '../components/RoleEntry.astro';
import SectionHead from '../components/SectionHead.astro';
import { getCollection, render } from 'astro:content';

const title = 'Work — Wei Yan';
const description = "Wei Yan's work experience and internships.";

const roles = await getCollection('roles');
const sorted = [...roles].sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
const rendered = await Promise.all(sorted.map((entry) => render(entry)));
---

<BaseLayout title={title} description={description}>
  <section>
    <h1>Work</h1>
    <SectionHead label="DIVE LOG — WORK" />
    <div class="roles">
      {
        sorted.map((entry, i) => {
          const { Content } = rendered[i];
          return (
            <RoleEntry
              org={entry.data.org}
              role={entry.data.role}
              team={entry.data.team}
              discipline={entry.data.discipline}
              start={entry.data.start}
              end={entry.data.end}
              current={entry.data.current}
              depth={entry.data.depth}
              tags={entry.data.tags}
              open={i === 0}
            >
              <Content />
            </RoleEntry>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* Mockup's .log: a gapped stack of cards, water visible between them —
     see RoleEntry.astro for the card itself. These are the expandable
     branch: Home shows the same rows without the bullets, and this page is
     where they open. */
  .roles {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 32px;
  }
</style>
